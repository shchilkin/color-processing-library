{
  "name": "color-processing-library",
  "version": "2.0.0",
  "description": "A modern TypeScript library for color processing",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shchilkin/color-processing-library.git"
  },
  "author": "Aleksandr Shchilkin <crazyredkitten@icloud.com> (https://crazyredkitten.media/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shchilkin/color-processing-library/issues"
  },
  "homepage": "https://github.com/shchilkin/color-processing-library#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
